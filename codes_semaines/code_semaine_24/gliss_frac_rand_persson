    plt.close(fig_def)
else:
    plt.show()
 

#calcul du coef de frottement
fn = load * L * L
mu_final = ft / fn

chemin_txt = f"{nom_doss}/deformee_step_{suff_pas}_load_{suff_load}_H_{suff_hurst}_V_{suff_v_cible}_ta_{suff_temps_attente}.txt"
with open(chemin_txt, "w") as f:
    
    f.write(f"Ft = {ft}\nmu = {mu_final}\nAire_reelle_initiale = {A_reel_exact_ta}\nAire_reelle_finale = {A_reel}\n")
chemin_pic = f"{nom_doss}/pic_frottement_step_{suff_pas}_load_{suff_load}_H_{suff_hurst}_V_{suff_v_cible}_ta_{suff_temps_attente}.txt"
pic_max = np.max(historique_ft)
np.savetxt(chemin_pic, [temps_attente, pic_max])

#%%

##### méthode carbone putignano #####
tau = 1.0  
vit = v_cible 

#la rugosité recule sur l'axe y dans le np.roll (axis=1, shift=-1), donc la vitesse relative est -vit
omega_car = qy * vit  

#terme devant le G
#calcul du module dynamique complexe E*(w), pour plusieurs branche il faut combiner l ensemble des tau et des G contrairement 
#au modele précédent a une branche ou l'on avait 1 seul G et un seul tau
E_inf = model.E  #rigidité à temps infini (relaxée), vaut 1.0 dans le code
E_complexe = np.full(qy.shape, E_inf, dtype=complex) #grille de la meme taille que les freqs avec des nmbres complexes pour le calcul de E_complexe de chaque branche

#on additionne la contribution de chaque branche de Maxwell
for j in range(len(E_branches)):
    #pour un coefficient de poisson nu=0.5, on a E = 3 * G
    delta_E_j = E_branches[j]
    tau_j = tau_i[j]
    
    #formule de la rigidité complexe pour une branche de maxwell
    E_complexe += delta_E_j * (1j * omega_car * tau_j) / (1 + 1j * omega_car * tau_j)


#calcul du modificateur de la matrice de Green (Souplesse dynamique)
#(plus le matériau est rigide à haute fréquence, plus M_qv devient petit (déformation faible))
M_qv = E_inf / E_complexe

#ensuite les calculs sont les mêmes que pour une branche
solver_stat = tm.PolonskyKeerRey(model, surface, 1e-9)
solver_stat.solve(load)

Green_OG = model.operators['westergaard_neumann']['influence'][:].copy()
#on modifie le G 
model.operators['westergaard_neumann']['influence'][:] = Green_OG.copy()

Green = model.operators['westergaard_neumann']['influence'][:].copy()
model.operators['westergaard_neumann']['influence'][:] = Green * M_qv

#résolution avec le nouveau G
solver_stat.solve(load)

#calcul de la force asymptotique
ft_carbone = np.sum((model.traction) * pente_x) * dS
print(f"Force asymptotique (Carbone-Putignano) : {ft_carbone:.4e}")


#%%

#### calcul analytique pour contact complet ####
#on utilise la matrice de green
G_complexe = Green * M_qv
G_complexe[0, 0] = 1.0 #pour éviter la division par zéro en q=0

h_fft = np.fft.rfft2(surface) #tf de la surface

p_fft = h_fft / G_complexe # calcul de la pression analytique
p_fft[0, 0] = 0.0 #on annule la pression moyenne

pente_spectrale_fft = 1j * qy * h_fft

#retour dans l'espace réel
p_analytique = np.fft.irfft2(p_fft, s=(N, N))
pente_analytique = np.fft.irfft2(pente_spectrale_fft, s=(N, N))

ft_parseval = np.sum(p_analytique * pente_analytique) * dS
print(f"Force  de frottement approximée  : {ft_parseval:.4e}")


#%%
#### solution analytique continue EXACTE (spectre infini)
# Basée sur la transformée de Fourier de la dérivée de la fonction de Mittag-Leffler
# Pour le modèle de Zener fractionnaire normalisé, le temps de fluage de base tau_C est 1.0
##basé notamment sur l'article de Zichen et Lucas
##volution of the contact between rough
##viscoelastic solids after decreasing loads: memory
## erasure and monotonic increase
vit = v_cible
omega = qy * vit

tau_C = 1.0  

#calcul direct de M_qv continu avec la puissance fractionnaire alpha
#formule : M_qv = k + (1-k) / (1 + (i * omega * tau_C)**alpha)
terme_complexe = (1j * omega * tau_C)**alpha
M_qv_continu = k + (1.0 - k) / (1.0 + terme_complexe)

#modification de la matrice de Green
G_complexe_continu = Green_OG.copy() * M_qv_continu
G_complexe_continu[0, 0] = 1.0  # pour éviter la division par zéro

#résolution de la pression spectrale
p_fft_continu = h_fft / G_complexe_continu
p_fft_continu[0, 0] = 0.0  # Annule la pression moyenne

#retour dans l'espace réel
p_analytique_continu = np.fft.irfft2(p_fft_continu, s=(N, N))

#calcul de la force de frottement continue
ft_exact = np.sum(p_analytique_continu * pente_analytique) * dS
print(f"Force de frottement continue (spectre infini) : {ft_exact:.4e}")
#%%

#calcul de l'erreur relative entre tamaas et carbone-putignano
erreur_relative = abs(historique_ft[-1] - ft_carbone) / ft_carbone * 100
force_normale = load * L**2 #force normale réelle appliquée

#calcul de l'erreur relative entre tamaas et carbone-putignano
err_tp=abs(historique_ft[-1]-ft_parseval)/ft_parseval *100

#calcul de l'erreur relative entre parseval et carbone-putignano
err_cp=abs(ft_carbone-ft_parseval)/ft_parseval *100

print("erreur tamaas/parseval : ",err_tp,"erreur carbone_parseval : ",err_cp)


#calcul de l'erreur relative entre tamaas et solution_exacte
err_te=abs(historique_ft[-1] -ft_exact)/ft_exact *100

ratio_ft_fn=historique_ft[-1]/force_normale
#tracé de fx et mu
fig_fx, ax_fx = plt.subplots(figsize=(8, 5))

#changement du nom dans la légende
ax_fx.plot(temps, historique_ft, 'r-', lw=1.5, label="Simulation numérique")

#ajout des asymptotes analytiques
ax_fx.axhline(y=ft_parseval, color='g', linestyle=':', label="Solution analytique discretisée")
ax_fx.axhline(y=ft_exact, color='grey', linestyle='-', label="Solution analytique continue")

#boîte de texte épurée avec seulement la force et les deux erreurs
texte_info = (f"Force normale (Load) : {force_normale:.2e} N\n" 
              f"Erreur Tamaas/discrétisée : {err_tp:.2f} %\n" 
              f"Erreur Tamaas/continue : {err_te:.2f} %")

#on place la boîte de texte (légèrement descendue pour ne pas cacher les courbes)
ax_fx.text(0.4, 0.45, texte_info, transform=ax_fx.transAxes, fontsize=10,
           verticalalignment='top', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))

#textes des axes et du titre en gras
ax_fx.set_xlabel("Temps (s)", fontweight='bold')
ax_fx.set_ylabel("Force de frottement Ft (N)", fontweight='bold')
ax_fx.set_title(f"Frottement (surface sinusoïdale) (Pas = {pas}, N = {N}, vit = {v_cible})", fontweight='bold')
ax_fx.grid()

#chiffres de l'axe X et de l'axe Y principal (gauche) en gras
for label in ax_fx.get_xticklabels() + ax_fx.get_yticklabels():
    label.set_fontweight('bold')

#légende en gras
legend_fx = ax_fx.legend(loc='lower right')
for text in legend_fx.get_texts():
    text.set_fontweight('bold')

#ajout de mu sur le deuxième axe (axe de droite)
ax_mu = ax_fx.twinx()
ymin, ymax = ax_fx.get_ylim()
ax_mu.set_ylim(ymin / fn, ymax / fn)
ax_mu.set_ylabel("Coefficient de frottement $\mu$", color='red', fontweight='bold')

#chiffres de l'axe Y secondaire (droite) en gras
for label in ax_mu.get_yticklabels():
    label.set_fontweight('bold')

#sauvegarde de l'image
fig_fx.savefig(f"{nom_doss}/courbe_fx_total_step_{suff_pas}_load_{suff_load}_H_{suff_hurst}_V_{suff_v_cible}_ta_{suff_temps_attente}.png")


#### tracé frottement/vitesse - Matériau fractionnaire (analytique Continu)

#tableau de vitesses (élargi de 10^-3 à 10^9.5 pour voir toute la cloche)
vitesses_theoriques = np.logspace(-3, 9.5, 100)
ft_theoriques_continu = []

#temps caractéristique de fluage de base
tau_C = 1.0  

#boucle sur toutes les vitesses pour calculer le régime permanent théorique continu
for v_test in vitesses_theoriques:
    
    #fréquence d'excitation pour cette vitesse spécifique
    omega_test = qy * v_test  
    
    #souplesse dynamique continue exacte (M_qv_continu)
    #formule : M_qv(w) = k + (1-k) / (1 + (i*w*tau_C)^alpha)
    terme_complexe_test = (1j * omega_test * tau_C)**alpha
    M_qv_continu_test = k + (1.0 - k) / (1.0 + terme_complexe_test)
    
    #matrice de Green modifiée pour cette vitesse
    G_complexe_test = Green_OG.copy() * M_qv_continu_test
    G_complexe_test[0, 0] = 1.0  # évite la division par zéro en q=0
    
    #calcul de la pression analytique spectrale
    p_fft_test = h_fft / G_complexe_test
    p_fft_test[0, 0] = 0.0  # Annule la pression moyenne
    
    #retour dans l'espace réel
    p_analytique_test = np.fft.irfft2(p_fft_test, s=(N, N))
    
    # Force de frottement asymptotique continue
    ft_test = np.sum(p_analytique_test * pente_analytique) * dS
    ft_theoriques_continu.append(ft_test)

ft_theoriques_continu = np.array(ft_theoriques_continu)

#récupération de la valeur numérique finale
ft_numerique_final = historique_ft[-1]

import matplotlib.ticker as ticker

fig_cloche, ax_cloche = plt.subplots(figsize=(9, 6))

#courbe théorique continue
ax_cloche.plot(vitesses_theoriques, ft_theoriques_continu, 'b-', lw=2, 
               label="Analytique continue ")

#point de la simulation numérique Tamaas
ax_cloche.plot([v_cible], [ft_numerique_final], 'ro', markersize=8, 
               label=f"Numérique Tamaas (V={v_cible} m/s, Ft={ft_numerique_final:.3e} N)")

#point de l'analytique discrétisée (Carbone/Parseval sur les 30 branches)
#ax_cloche.plot([v_cible], [ft_parseval], 'g^', markersize=8, 
#               label=f"Analytique discrète (V={v_cible} m/s, Ft={ft_parseval:.3e} N)")

ax_cloche.set_xscale('log')

#force l'affichage des petits traits (ticks mineurs) sur l'axe X
ax_cloche.xaxis.set_major_locator(ticker.LogLocator(base=10.0, numticks=15))
ax_cloche.xaxis.set_minor_locator(ticker.LogLocator(base=10.0, subs=np.arange(2, 10), numticks=100))

#textes des axes et du titre en gras
ax_cloche.set_xlabel("Vitesse de glissement V (m/s)", fontweight='bold')
ax_cloche.set_ylabel("Force de frottement Ft (N)", fontweight='bold')
